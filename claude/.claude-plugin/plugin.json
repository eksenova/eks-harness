{
  "name": "eks-harness",
  "displayName": "eks-harness",
  "version": "0.2.0",
  "description": "Drive browsers, simulators and emulators, run backends and flows, capture evidence, edit and render videos, and score synchronized Blender, web and device scenes with eks-harness.",
  "author": {
    "name": "eks-harness maintainers"
  },
  "keywords": [
    "testing",
    "ui",
    "harness",
    "playwright",
    "ios",
    "android",
    "react-native",
    "video",
    "blender",
    "mcp"
  ],
  "mcpServers": {
    "eks-harness": {
      "command": "sh",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/mcp.sh"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "EKS_HARNESS_TREE": "${CLAUDE_PROJECT_DIR:-}"
      }
    }
  }
}
