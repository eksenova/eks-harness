{
  "name": "@eks-harness/scene",
  "version": "0.1.0",
  "description": "Virtual clock, score events and textures for HTML/JS scenes rendered or played by eks-harness",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": "./dist/scene-runtime.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "happy-dom": "^18.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
