{
  "name": "@eks-harness/ui-sdk",
  "version": "0.1.0",
  "description": "Slot types, hooks, tokens and components for eks-harness UI plugin modules",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./tokens.css": "./dist/tokens.css"
  },
  "files": ["dist"],
  "peerDependencies": { "react": ">=19" },
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
