from __future__ import annotations

from eks_harness.plugins.sdk import Persona, PluginContext


class Personas:
    def __init__(self, context: PluginContext) -> None:
        self.context = context

    def personas(self, target: str) -> list[Persona]:
        return [Persona(id="admin", label="Administrator", username="admin@example.test")]

    def secret(self, persona: Persona) -> str:
        return str(self.context.settings.get("password") or "")
