from __future__ import annotations

from collections.abc import Mapping
from typing import Any

from eks_harness.plugins.sdk import Persona, PluginContext


class Login:
    platforms = ("web", "ios", "android")

    def __init__(self, context: PluginContext) -> None:
        self.context = context

    def login(self, session: Any, persona: Persona, *, target: str, options: Mapping[str, Any]) -> None:
        session.act("navigate", url=f"{target}/login")
        session.act("fill", selector="input[name=email]", text=persona.username)
