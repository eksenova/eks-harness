from {{module}}.backend import Backend


def test_describe_spec_and_info() -> None:
    backend = Backend.__new__(Backend)
    assert backend.describe()["ports"] == ["http"]
    spec = backend.spec({"ports": {"http": 5999}}).as_dict()
    assert spec["processes"][0]["port"] == "http" and spec["info"]["url"] == "http://127.0.0.1:{ports.http}"
    info = backend.info({}).as_dict()
    assert info["credentials"]["admin"]["password"] == {"$secret": "change-me"}
